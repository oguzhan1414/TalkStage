# Optional overrides. Google Play uses the published Spekvia listing by default.
# Leave iOS blank to show "Coming soon" until the App Store listing is live.
NEXT_PUBLIC_IOS_STORE_URL=
NEXT_PUBLIC_ANDROID_STORE_URL=
NEXT_PUBLIC_APP_SCHEME=spekvia://

# PostHog product analytics (posthog.com, free tier). Leave blank to keep
# analytics fully disabled (src/lib/analytics.tsx no-ops with no key).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
