# Public Supabase keys (safe for client bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# TalkStage backend (FastAPI) base URL, e.g. http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=

# Google OAuth client IDs (Google Cloud Console -> Credentials), used by
# expo-auth-session for "Sign in with Google" -> Supabase signInWithIdToken.
# At least one of these must be set; Supabase project also needs the Google
# provider enabled with the same client(s).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK API keys (RevenueCat dashboard -> Project -> API keys).
# Leave blank to keep the Paywall screen in its "not configured" fallback mode.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
