# Public Supabase keys (safe for client bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Spekvia backend (FastAPI) base URL, e.g. http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=

# Media origin for scenario videos + podcasts: Supabase Storage public bucket, e.g.
# https://<project-ref>.supabase.co/storage/v1/object/public/media (falls back to EXPO_PUBLIC_API_BASE_URL).
EXPO_PUBLIC_MEDIA_BASE_URL=

# (Privacy / terms / account-deletion pages need no variable: `src/constants/legalLinks.ts` opens the right
# localized page on spekvia.com.)

# Google sign-in: the browser flow (Expo Go / web) needs NO client id in the app — set the Google *Web* client id +
# secret in Supabase -> Authentication -> Providers -> Google. The same Web client id here (public, not a secret)
# turns on the native in-app account sheet in development/production builds (needs an Android OAuth client with
# package name + SHA-1 too). Leave blank to always use the browser flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK API keys (RevenueCat dashboard -> Project -> API keys).
# Leave blank to keep the Paywall screen in its "not configured" fallback mode.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# PostHog product analytics (posthog.com, free tier). Host must match your project region
# (https://us.i.posthog.com or https://eu.i.posthog.com). Leave the key blank to keep
# analytics fully disabled (src/lib/analytics.tsx no-ops with no key).
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
