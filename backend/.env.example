ENVIRONMENT=development

# Supabase (https://app.supabase.com -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# STT (choose one)
DEEPGRAM_API_KEY=
# GROQ_API_KEY also powers the text-chat LLM (POST /chat/message, "Günlük
# Sohbet" mode) via Groq's OpenAI-compatible chat completions API — one key
# covers both.
GROQ_API_KEY=

# LLM (choose one)
OPENAI_API_KEY=
GEMINI_API_KEY=

# TTS (choose one)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=

# Payments
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=

# Cache (optional, for semantic caching)
REDIS_URL=

# Observability (optional)
SENTRY_DSN=

# Voice limits are deliberately disabled during product testing.
VOICE_QUOTA_ENABLED=false
