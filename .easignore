# EAS Build uploads the whole repo (monorepo). Keep it small: the app only needs mobile/ and packages/shared-data.
# Patterns start with "/" so they only match at the repo root (never mobile/assets/images etc.).
# landing/ stays as a package.json only because it is listed in the root npm workspaces.
/videos/
/playstore_promo/
/backend/
/video-studio/
/images/
/mobil_images/
/screenshots/
/brand/
/reports/
/podcast/
/*.mp4
/*.md
landing/*
!landing/package.json
